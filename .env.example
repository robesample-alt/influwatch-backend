# ============================================================
# FUNDUREX — INFLUWATCH PHASE 1
# Environment variables — copy to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# PostgreSQL — app role (non-superuser, RLS enforced)
DATABASE_URL=postgresql://iw_app:PASSWORD@HOST:5432/influwatch

# Admin connection — superuser for migrations only
DATABASE_URL_ADMIN=postgresql://postgres:PASSWORD@HOST:5432/influwatch

# Server
PORT=3001
NODE_ENV=production

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# Logging
LOG_LEVEL=info

# OpenAI — for video transcription (Phase 2)
OPENAI_API_KEY=

# Anthropic — for LLM contextual detection (Phase 2)
# Required for semantic compliance findings on HIGH/CRITICAL posture promoters.
# Missing key disables LLM detection but leaves phrase-based detection intact.
ANTHROPIC_API_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Email alerts (Resend) — leave empty to disable
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@influwatch.fundurex.com
ALERT_EMAIL_TO=compliance@yourfirm.com
