// ============================================================
// FUNDUREX — INFLUWATCH PHASE 1 + MULTI-TENANT
// Prisma Schema
//
// Purpose: Content archive foundation for promotional
// content supervision, recordkeeping, and audit defensibility.
//
// Multi-tenant: every table is scoped by tenantId.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AmbassadorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_REVIEW
}

enum PromoterRiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SourcePlatform {
  YOUTUBE
  INSTAGRAM
  TWITTER_X
  TIKTOK
  LINKEDIN
  FACEBOOK
  TELEGRAM
  EMAIL
  PODCAST
  BLOG
  OTHER
}

enum ContentType {
  VIDEO
  SHORT_FORM_VIDEO
  IMAGE_POST
  CAROUSEL
  STORY
  REEL
  TWEET
  THREAD
  LONG_FORM_POST
  EMAIL_BLAST
  PODCAST_EPISODE
  LIVE_STREAM
  NEWSLETTER
  OTHER
}

enum CampaignStatus {
  FORMATION
  DSS_EVALUATION
  APPROVED
  LIVE
  CLOSED
  CANCELLED
}

enum CampaignType {
  INVESTMENT
  FINTECH
  FINANCIAL_PRODUCT
  PLATFORM_LAUNCH
}

enum ArchiveStatus {
  CAPTURED          // Raw record ingested, not yet reviewed
  PENDING_REVIEW    // Flagged for human review queue
  REVIEWED          // Human review complete — no action taken
  ESCALATED         // Elevated to compliance officer
  INCIDENT_OPENED   // Formal incident created from this record
  CLOSED            // Review closed, record retained
  PURGED            // Record marked for deletion per retention policy
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum DetectionMethod {
  PHRASE_MATCH
  DISCLOSURE_CHECK
  PATTERN_MATCH
  LLM_ANALYSIS
}

enum AssetType {
  VIDEO_FILE
  THUMBNAIL
  SCREENSHOT
  AUDIO_FILE
  ATTACHMENT
  TRANSCRIPT_FILE
  RAW_HTML
}

enum ArchiveEventType {
  RECORD_CREATED
  STATUS_CHANGED
  MEDIA_ATTACHED
  REVIEW_STARTED
  REVIEW_COMPLETED
  ESCALATION_RAISED
  INCIDENT_LINKED
  NOTE_ADDED
  RECORD_EXPORTED
  RECORD_PURGED

  // Compliance Action Engine — Phase 1
  COMPLIANCE_APPROVED
  COMPLIANCE_EDIT_REQUESTED
  COMPLIANCE_WARN_ISSUED
  COMPLIANCE_PROMOTER_SUSPENDED
  COMPLIANCE_ESCALATED
  COMPLIANCE_CERTIFIED    // Supervisory sign-off — case formally closed (FINRA 3110 / 3130)
}

// ─────────────────────────────────────────
// INTERNAL ACTOR ENUMS
// ─────────────────────────────────────────

enum InternalActorRole {
  REGISTERED_PRINCIPAL   // Series 24 / RP — final supervisory authority
  DESIGNATED_SUPERVISOR  // Series 24 / DS — day-to-day review supervisor
  REVIEWER               // Internal compliance staff (non-supervisory)
  COMPLIANCE_OFFICER     // CCO / compliance function
  TENANT_ADMIN           // Platform admin — no supervisory authority
}

enum InternalActorStatus {
  ACTIVE
  INACTIVE
  INVITED
}

// ─────────────────────────────────────────
// TENANT
//
// Root identity for each firm using InfluWatch.
// Every other model in the system references a Tenant.
// ─────────────────────────────────────────

model Tenant {
  id              String       @id @default(cuid())
  firmName        String
  slug            String       @unique  // URL-safe identifier, e.g. "meridian-capital"
  crdNumber       String?               // FINRA CRD number
  secRegistration String?               // SEC registration number
  status          TenantStatus @default(ACTIVE)
  plan            String?               // Subscription tier

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations — one Tenant owns all of the following
  config                  TenantConfig?
  internalActors          InternalActor[]
  ambassadorProfiles      AmbassadorProfile[]
  campaigns               Campaign[]
  contentRecords          ContentRecord[]
  contentMediaAssets      ContentMediaAsset[]
  archiveEventLogs        ArchiveEventLog[]
  supervisoryAttestations SupervisoryAttestation[]
  programCertifications   ProgramCertification[]
  promoterContracts       PromoterContract[]
  legalHolds              LegalHold[]
  evidenceExports         EvidenceExport[]
  preApprovalRequests     PreApprovalRequest[]
  tailPeriods             TailPeriod[]
  detectionRecords        DetectionRecord[]
  compensationStructures  CompensationStructure[]
  affiliateLinks          AffiliateLink[]
  compensationEvents      CompensationEvent[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// INTERNAL ACTOR
//
// Represents a Fundurex internal staff member:
// supervisory principals, reviewers, compliance officers.
// Used as the source-of-truth for User Management.
// Linked to AmbassadorProfile for supervisory assignment.
// ─────────────────────────────────────────

model InternalActor {
  id              String              @id @default(cuid())
  displayName     String
  email           String
  role            InternalActorRole
  status          InternalActorStatus @default(ACTIVE)
  passwordHash    String?             // bcrypt hash — null until first seed or password set
  seriesLicense   String?             // e.g. "Series 24", "Series 65"
  mfaEnabled      Boolean             @default(false)
  lastLoginAt     DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Tenant
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  supervisedPromoters    AmbassadorProfile[]      @relation("SupervisedBy")
  attestations           SupervisoryAttestation[]
  programCertifications  ProgramCertification[]
  assignedPreApprovals   PreApprovalRequest[]     @relation("AssignedPrincipal")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@map("internal_actors")
}

// ─────────────────────────────────────────
// AMBASSADOR PROFILE
//
// Represents a creator or ambassador in the
// Fundurex system. Used as the source identity
// for all archived content records.
// ─────────────────────────────────────────

model AmbassadorProfile {
  id              String            @id @default(cuid())
  displayName     String
  handle          String
  primaryPlatform SourcePlatform
  status          AmbassadorStatus  @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Risk classification — set at onboarding, updated by compliance staff
  riskTier        PromoterRiskTier?

  // Supervisory assignment
  assignedSupervisorId  String?
  assignedSupervisor    InternalActor?  @relation("SupervisedBy", fields: [assignedSupervisorId], references: [id], onDelete: SetNull)

  // Phyllo social content ingestion
  phylloUserId    String?           // Phyllo user ID for this promoter
  phylloAccountId String?           // Phyllo connected account ID

  // Tenant
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  contentRecords      ContentRecord[]
  contracts           PromoterContract[]
  tailPeriods         TailPeriod[]
  preApprovalRequests PreApprovalRequest[]

  @@index([tenantId])
  @@index([handle])
  @@index([status])
  @@index([primaryPlatform])
  @@index([phylloAccountId])
  @@index([assignedSupervisorId])
  @@map("ambassador_profiles")
}

// ─────────────────────────────────────────
// PROMOTER CONTRACT
//
// Written agreements between the firm and a promoter.
// Covers promoter agreements, NDAs, disclosure acknowledgments.
// One promoter may have multiple contracts over time.
// ─────────────────────────────────────────

model PromoterContract {
  id                     String           @id @default(cuid())

  // Promoter link
  ambassadorId           String
  ambassador             AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  // Agreement identity
  agreementType          String           // e.g. "Promoter Agreement", "NDA", "Disclosure Acknowledgment"
  contractId             String           // human-readable ref e.g. "AGR-2026-001"

  // Key dates
  signedDate             DateTime
  effectiveDate          DateTime
  expiryDate             DateTime?

  // Compliance flags
  monitoringConsent      Boolean          @default(false)
  disclosureAck          Boolean          @default(false)
  disclosureRuleEnforced Boolean          @default(true)

  // Compensation terms
  compensationCap        Float?
  compensationType       String?          // e.g. "Revenue Share", "Fixed Fee"
  compensationRate       String?          // e.g. "8% of AUM", "$500/mo"

  // State
  status                 String           @default("ACTIVE")
  notes                  String?

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  // Tenant
  tenantId               String
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contractId])
  @@index([tenantId])
  @@index([ambassadorId])
  @@index([status])
  @@map("promoter_contracts")
}

// ─────────────────────────────────────────
// CAMPAIGN
//
// Represents a Fundurex distribution campaign.
// ContentRecords are optionally linked to a campaign
// at archive time or during review.
// ─────────────────────────────────────────

model Campaign {
  id             String         @id @default(cuid())
  campaignName   String
  campaignType   CampaignType
  status         CampaignStatus @default(FORMATION)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Tenant
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  contentRecords ContentRecord[]

  @@index([tenantId])
  @@index([status])
  @@index([campaignType])
  @@map("campaigns")
}

// ─────────────────────────────────────────
// CONTENT RECORD
//
// The core InfluWatch archive unit.
// Represents a single piece of promotional content
// published by an ambassador, captured for
// supervision and compliance recordkeeping.
//
// archiveStatus drives the review workflow state.
// checksum enables deduplication and tamper detection.
// ─────────────────────────────────────────

model ContentRecord {
  id                 String          @id @default(cuid())

  // Source identity
  ambassadorId       String
  ambassador         AmbassadorProfile @relation(fields: [ambassadorId], references: [id])

  // Campaign linkage — nullable (may be linked post-capture)
  campaignId         String?
  campaign           Campaign?       @relation(fields: [campaignId], references: [id])

  // Source metadata
  sourcePlatform     SourcePlatform
  contentType        ContentType
  sourceUrl          String
  externalContentId  String?         // Platform-native ID (e.g. YouTube video ID, tweet ID)

  // Content body
  title              String?
  bodyText           String          // Caption, post copy, or summary
  transcriptText     String?         // Full transcript for video/audio content

  // Timestamps
  postedAt           DateTime?       // When the content was originally published
  capturedAt         DateTime        @default(now())  // When IW archived it

  // Archive state
  archiveStatus      ArchiveStatus   @default(CAPTURED)
  severity           Severity?

  // Integrity
  checksum           String?         // SHA-256 of bodyText + sourceUrl for dedup/tamper check

  // Compensation context — set at ingestion from promoter's CompensationStructure
  compensationPosture  String?       // LOW | MEDIUM | HIGH | CRITICAL
  hasAffiliateLink     Boolean       @default(false)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Tenant
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  mediaAssets        ContentMediaAsset[]
  eventLog           ArchiveEventLog[]
  detectionRecords   DetectionRecord[]

  @@index([tenantId])
  @@index([ambassadorId])
  @@index([campaignId])
  @@index([sourcePlatform])
  @@index([archiveStatus])
  @@index([capturedAt])
  @@index([postedAt])
  @@index([externalContentId])
  @@map("content_records")
}

// ─────────────────────────────────────────
// CONTENT MEDIA ASSET
//
// Media files associated with a ContentRecord.
// Thumbnails, video files, screenshots, transcripts.
// Stored as references to external storage (S3/GCS/etc).
// ─────────────────────────────────────────

model ContentMediaAsset {
  id              String        @id @default(cuid())
  contentRecordId String
  contentRecord   ContentRecord @relation(fields: [contentRecordId], references: [id], onDelete: Cascade)

  assetType       AssetType
  assetUrl        String        // Storage URL or path
  mimeType        String?       // e.g. "video/mp4", "image/jpeg"
  durationSeconds Int?          // For audio/video assets

  createdAt       DateTime      @default(now())

  // Tenant
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contentRecordId])
  @@index([assetType])
  @@map("content_media_assets")
}

// ─────────────────────────────────────────
// ARCHIVE EVENT LOG
//
// Immutable audit trail for every state change
// on a ContentRecord. Append-only by design.
// Never update or delete rows from this table.
// ─────────────────────────────────────────

model ArchiveEventLog {
  id              String           @id @default(cuid())
  contentRecordId String
  contentRecord   ContentRecord    @relation(fields: [contentRecordId], references: [id], onDelete: Cascade)

  eventType       ArchiveEventType
  eventNote       String?          // Human-readable description of the event
  actorId         String?          // User or system that triggered the event (future: auth user id)

  createdAt       DateTime         @default(now())

  // Tenant
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contentRecordId])
  @@index([eventType])
  @@index([createdAt])
  @@map("archive_event_logs")
}

// ─────────────────────────────────────────
// SUPERVISORY ATTESTATION
//
// Formal periodic supervisory certification record.
// Represents a principal's attestation that they have
// reviewed and supervised promotional activity for a
// defined period (FINRA Rule 3110 / 3130).
// ─────────────────────────────────────────

model SupervisoryAttestation {
  id                String        @id @default(cuid())

  // Signing principal
  principalId       String
  principal         InternalActor @relation(fields: [principalId], references: [id], onDelete: Restrict)

  // Supervision period
  periodLabel       String        // Human-readable e.g. "Q1 2026"
  periodStart       DateTime
  periodEnd         DateTime

  // Scope
  promotersInScope  Int           // Count of promoters supervised during this period

  // Sign-off
  certifiedAt       DateTime      @default(now())
  supervisoryNote   String?       // Optional attestation narrative

  // Tenant
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([principalId])
  @@index([certifiedAt])
  @@map("supervisory_attestations")
}

// ─────────────────────────────────────────
// PROGRAM CERTIFICATION
//
// Annual supervisory program certification record.
// Represents a registered principal's annual attestation
// that the firm's written supervisory procedures (WSPs)
// and supervisory system meet FINRA Rule 3110/3120/3130
// requirements for the given calendar year.
// ─────────────────────────────────────────

model ProgramCertification {
  id                        String        @id @default(cuid())

  // Signing principal
  principalId               String
  principal                 InternalActor @relation(fields: [principalId], references: [id], onDelete: Restrict)

  // Certification scope
  certificationYear         Int                            // e.g. 2026
  certifiedAt               DateTime      @default(now())
  rulesCertified            String                         // e.g. "FINRA 3110, FINRA 3120, FINRA 3130"

  // Attestation
  supervisorySystemAdequate Boolean                        // principal's attestation that the system is adequate
  findings                  String?                        // any findings or exceptions noted
  certificationNote         String?

  // Tenant
  tenantId                  String
  tenant                    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([principalId])
  @@index([certificationYear])
  @@index([certifiedAt])
  @@map("program_certifications")
}

// ─────────────────────────────────────────
// TENANT CONFIG
//
// Per-tenant operational settings: monitoring,
// SLA thresholds, data retention policy.
// Firm identity fields live on the Tenant model.
// One TenantConfig per Tenant (1:1).
// ─────────────────────────────────────────

model TenantConfig {
  id                      String   @id @default(cuid())

  // Tenant (1:1)
  tenantId                String   @unique
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Monitoring settings
  pollIntervalMinutes     Int      @default(60)
  historicalBackfillDays  Int      @default(30)
  authErrorAlertThreshold Int      @default(3)
  gapReportThreshold      Int      @default(2)
  postContractTailDays    Int      @default(60)

  // SLA thresholds (hours)
  slaThresholdCritical    Int      @default(24)
  slaThresholdHigh        Int      @default(48)
  slaThresholdMedium      Int      @default(120)
  slaThresholdLow         Int      @default(240)

  // Data retention
  retentionYears          Int      @default(7)
  objectLockMode          String   @default("COMPLIANCE")

  updatedAt               DateTime @updatedAt

  @@map("tenant_config")
}

// ─────────────────────────────────────────
// LEGAL HOLD
//
// Represents a regulatory or litigation hold
// placed on content records, freezing them from
// purge or modification until released.
// ─────────────────────────────────────────

model LegalHold {
  id              String    @id @default(cuid())

  holdName        String
  holdType        String                        // e.g. 'Regulatory Inquiry', 'Subpoena', 'Litigation'
  scope           String                        // description of what records are frozen
  recordsFrozen   Int       @default(0)

  placedBy        String                        // actorId of who placed the hold
  legalAuthority  String                        // e.g. 'SEC Subpoena', 'FINRA Rule 8210'
  datePlaced      DateTime  @default(now())
  basis           String                        // reason for the hold

  status          String    @default("ACTIVE")  // ACTIVE | RELEASED

  releasedBy      String?
  releasedAt      DateTime?
  releaseReason   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Tenant
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([datePlaced])
  @@map("legal_holds")
}

// ─────────────────────────────────────────
// EVIDENCE EXPORT
//
// Represents a generated export package for
// regulatory submission, legal production, or
// internal audit. Aggregates existing records
// into a logged, checksummed export artifact.
// ─────────────────────────────────────────

model EvidenceExport {
  id               String    @id @default(cuid())

  exportType       String                        // 'FLAG_EVIDENCE' | 'PROMOTER_HISTORY' | 'AUDIT_TRAIL' | 'CERT_REPORT'
  generatedBy      String                        // actorId of who generated it
  generatedAt      DateTime  @default(now())

  // Scope filters captured at generation time
  dateRangeStart   DateTime?
  dateRangeEnd     DateTime?
  ambassadorId     String?                       // if scoped to one promoter

  // Package metadata
  recordCount      Int       @default(0)
  packageChecksum  String?                       // SHA-256 of the export metadata
  status           String    @default("COMPLETE")
  notes            String?

  // Tenant
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([generatedBy])
  @@index([exportType])
  @@index([generatedAt])
  @@index([ambassadorId])
  @@map("evidence_exports")
}

// ─────────────────────────────────────────
// PRE-APPROVAL REQUEST
//
// Represents a content pre-approval request submitted
// by or on behalf of an ambassador before publishing.
// A principal reviews and records a decision (APPROVED,
// REJECTED, or REVISION_REQUESTED).
// ─────────────────────────────────────────

model PreApprovalRequest {
  id                  String             @id @default(cuid())

  // Ambassador link
  ambassadorId        String
  ambassador          AmbassadorProfile  @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  // Submission metadata
  submittedBy         String             // actorId or ambassador handle
  contentType         String             // 'Social Post' | 'Video' | 'Blog' | 'Campaign Material'
  platform            String             // YOUTUBE | INSTAGRAM | TWITTER_X etc.
  contentPreview      String             // first 500 chars of the content

  // Scheduling
  requiredBy          DateTime?          // deadline for the decision

  // Assignment
  assignedPrincipalId String?
  assignedPrincipal   InternalActor?     @relation("AssignedPrincipal", fields: [assignedPrincipalId], references: [id], onDelete: SetNull)

  // Workflow state
  status              String             @default("PENDING")  // PENDING | APPROVED | REJECTED | REVISION_REQUESTED

  // Decision
  decision            String?            // principal's decision note
  decidedBy           String?            // actorId who made the decision
  decidedAt           DateTime?

  // SLA
  slaHours            Int                @default(48)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Tenant
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ambassadorId])
  @@index([status])
  @@index([assignedPrincipalId])
  @@index([createdAt])
  @@map("pre_approval_requests")
}

// ─────────────────────────────────────────
// POST-CONTRACT TAIL PERIOD
//
// Tracks ongoing monitoring obligations after a
// promoter contract ends. Required under SEC Rule 206(4)-1
// and FINRA Rule 2210 where continued post-contract
// promotional influence must be supervised.
// ─────────────────────────────────────────

model TailPeriod {
  id               String            @id @default(cuid())

  // Ambassador link
  ambassadorId     String
  ambassador       AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  // Tail dates
  contractEndDate  DateTime
  tailDays         Int               // Number of days to monitor after contract end
  tailStartDate    DateTime
  tailEndDate      DateTime          // = contractEndDate + tailDays

  // Context
  reason           String?           // Why monitoring is continuing
  riskTier         String?
  tailType         String            @default("STANDARD")  // STANDARD | EXTENDED | REGULATORY

  // State
  status           String            @default("ACTIVE")   // ACTIVE | CLOSED | EXPIRED
  postContractFlags Int              @default(0)

  // Closure
  closedAt         DateTime?
  closedBy         String?
  closedReason     String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Tenant
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ambassadorId])
  @@index([status])
  @@index([tailEndDate])
  @@map("tail_periods")
}

// ─────────────────────────────────────────
// DETECTION RECORD
//
// Structured evidence for each rule hit detected
// against a ContentRecord at ingestion time.
// Append-only — never update or delete rows.
// One row per matched phrase / rule combination.
//
// severity = the per-hit severity (phrase-level),
//            not the rule's nominal severity ceiling.
// ruleName = denormalized at write time so display
//            is safe if rule config changes later.
// ─────────────────────────────────────────

model DetectionRecord {
  id              String          @id @default(cuid())
  contentRecordId String
  contentRecord   ContentRecord   @relation(fields: [contentRecordId], references: [id], onDelete: Cascade)

  ruleCode        String          // e.g. "IW-BD-002"
  ruleName        String          // denormalized display name
  matchedPhrase   String?         // exact phrase that triggered the hit; null for absence-based rules
  severity        Severity        // severity of this specific hit
  detectionMethod DetectionMethod @default(PHRASE_MATCH)

  createdAt       DateTime        @default(now())

  // Tenant
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contentRecordId])
  @@index([ruleCode])
  @@map("detection_records")
}

// ─────────────────────────────────────────
// COMPENSATION STRUCTURE
//
// Defines the economic relationship between the firm
// and a promoter. Drives the classification engine
// and supervision posture for all content evaluation.
// ─────────────────────────────────────────

model CompensationStructure {
  id                        String   @id @default(cuid())
  promoterId                String
  campaignId                String?

  compensationForm          String   // FLAT_FEE | PER_CONTENT | RETAINER | REVENUE_SHARE | EQUITY | CARRY | INVESTMENT_BASED | CLICK_BASED | ENGAGEMENT_BONUS
  compensationTrigger       String   // LEAD | QUALIFIED_LEAD | SIGNUP | DEPOSIT | ACCOUNT_OPEN | FUNDED_ACCOUNT | INVESTMENT | SUBSCRIPTION | CAPITAL_RAISED | REVENUE_GENERATED
  productType               String   // REG_A | REG_CF | REG_D | FUND | ADVISORY_SERVICE | FINTECH | OTHER

  isTransactionBased        Boolean
  isSecurityLinked          Boolean
  isCompensationVariable    Boolean

  requiresDisclosure        Boolean
  requiresPrincipalReview   Boolean
  supervisionPosture        String   // LOW | MEDIUM | HIGH | CRITICAL

  // Phase 1 — Compensation Precision (additive, nullable for backward compat)
  // Computed server-side from compensationForm + compensationTrigger + productType.
  compensationType          String?  // Canonical type: UNCOMPENSATED | FLAT_FEE_PER_POST | FLAT_FEE_PER_CAMPAIGN | MONTHLY_RETAINER | CONTENT_PRODUCTION_FEE | AFFILIATE_NON_SECURITIES | LEAD_GEN_NON_FUNDED | PER_ACCOUNT_OPENED | PER_ACCOUNT_OPENED_AND_FUNDED | PER_LEAD_CONVERTED_TO_INVESTOR | PER_DOLLAR_INVESTED | REVENUE_SHARE_SECURITIES | EQUITY_OR_CARRY_NON_TRANSACTIONAL | OTHER
  compensationBasis         String?  // NONE | FIXED | PER_CONTENT_UNIT | PER_CAMPAIGN | PER_TIME_PERIOD | PER_LEAD | PER_ACCOUNT | PER_FUNDED_ACCOUNT | PER_INVESTOR | PERCENT_OF_RAISE | PERCENT_OF_INVESTMENT | OWNERSHIP_BASED | MANUAL_REVIEW
  transactionalityClass     String?  // NON_TRANSACTIONAL | ELEVATED_NON_TRANSACTIONAL | POTENTIALLY_TRANSACTIONAL | TRANSACTION_BASED

  writtenAgreementRequired  Boolean
  agreementReference        String?

  notes                     String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Tenant
  tenantId                  String
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([promoterId])
  @@index([supervisionPosture])
  @@map("compensation_structures")
}

// ─────────────────────────────────────────
// AFFILIATE LINK
//
// Distribution tracking layer. Each link is associated
// with a promoter and optionally a campaign and
// compensation structure. Securities-offering links
// trigger COMP-001 evaluation at ingestion.
// ─────────────────────────────────────────

model AffiliateLink {
  id                        String   @id @default(cuid())
  url                       String

  promoterId                String
  campaignId                String?

  compensationStructureId   String?

  isSecuritiesOffering      Boolean  @default(false)
  offeringType              String?  // REG_A | REG_CF | REG_D | FUND | OTHER

  linkType                  String   // DIRECT_OFFERING | LANDING_PAGE | TRACKED_REFERRAL | GENERIC

  active                    Boolean  @default(true)

  createdAt                 DateTime @default(now())

  // Tenant
  tenantId                  String
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([promoterId])
  @@index([active])
  @@map("affiliate_links")
}

// ─────────────────────────────────────────
// COMPENSATION EVENT
//
// Audit layer — immutable log of every supervision
// posture change for a promoter. Append-only.
// Never update or delete rows.
// ─────────────────────────────────────────

model CompensationEvent {
  id                String   @id @default(cuid())

  promoterId        String

  previousPosture   String
  newPosture        String

  reason            String?
  actorId           String?

  createdAt         DateTime @default(now())

  // Tenant
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([promoterId])
  @@index([createdAt])
  @@map("compensation_events")
}
